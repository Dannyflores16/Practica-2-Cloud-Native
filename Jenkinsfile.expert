pipeline {
    agent any

    environment {
    APP_NAME = "cloud-native-app"
    KUBECONFIG = "C:\\Users\\DANIEL\\.kube\\config"
}

    stages {

        stage('Checkout') {
            steps {
                echo 'Descargando código desde GitHub...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Instalando dependencias...'
                bat 'npm install'
            }
        }

        stage('Test') {
            steps {
                echo 'Ejecutando pruebas...'
                bat 'npm test'
            }
        }
stage('Terraform') {
    steps {
        echo 'Ejecutando Terraform...'
        dir('infrastructure\\terraform') {
            bat 'C:\\terraform\\terraform.exe init'
            bat 'C:\\terraform\\terraform.exe validate'
            bat 'C:\\terraform\\terraform.exe plan'
            bat 'C:\\terraform\\terraform.exe apply -auto-approve'
        }
    }
}

        stage('Build Docker Image') {
            steps {
                echo 'Construyendo imagen Docker...'
                bat 'docker build -t %APP_NAME%:latest .'
            }
        }
    

      stage('Kubernetes Deploy') {
            steps {
                echo 'Desplegando aplicación en Kubernetes...'

                bat 'kubectl apply -f kubernetes/deployment.yaml'
                bat 'kubectl apply -f kubernetes/service.yaml'
                bat 'kubectl apply -f kubernetes/hpa.yaml'

                bat 'kubectl get deployments'
                bat 'kubectl get pods'
                bat 'kubectl get hpa'
            }
        }
    }

    post {

        success {
            echo '✅ Pipeline ejecutado correctamente'
        }

        failure {
            echo '❌ El pipeline tuvo errores'
        }

        always {
            echo 'Pipeline finalizado.'
        }
    }
}